# Copy to .env locally, or enter values in Render Environment.
# WebRTC MVP: one room, two participants, one server process.
# Both trusted test participants need this random secret (at least 16 characters).
SAFETY_TOKEN=
# Leave blank ONLY for localhost browser development. For Android use real HTTPS origin.
PUBLIC_BASE_URL=
# Optional JSON list. Default uses public Google STUN, not a TURN relay.
# Across restrictive/mobile networks you may need your own TURN credentials.
# Authorized participants receive this ICE configuration; do not use an admin/API secret.
RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
ANALYSIS_MODE=gemini
# Server only: never put this API key in Android, browser code, URLs or chat.
GEMINI_API_KEY=
# Requested model; access and Live API support must be verified for your project.
GEMINI_MODEL=gemini-3.8-live
# diagnostic = calls work, but NO speech recognition or fraud analysis.
# WebRTC uses SAFETY_TOKEN; no external calling-service credentials are required.
