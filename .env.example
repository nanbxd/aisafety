# Copy to .env locally, or enter values in Render Environment.
# One server process and one active analysis session shared by WebRTC and Voximplant.
# Leave blank ONLY for localhost browser development. For Android use real HTTPS origin.
PUBLIC_BASE_URL=https://safetyhack-webrtc.onrender.com
# Optional FCM: path to SERVER service-account JSON (not Android google-services.json).
# Render: Environment > Secret Files > firebase-service-account.json, then set:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# Locally use an absolute path outside Git. Leave unset to disable push.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional JSON list. Default uses public Google STUN, not a TURN relay.
# Across restrictive/mobile networks you may need your own TURN credentials.
# Room participants receive this ICE configuration; do not use an admin/API secret.
RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
ANALYSIS_MODE=gemini
# Server only: never put this API key in Android, browser code, URLs or chat.
GEMINI_API_KEY=
# Requested model; access and Live API support must be verified for your project.
GEMINI_MODEL=gemini-3.8-live
# diagnostic = calls work, but NO speech recognition or fraud analysis.

# Voximplant ingress uses the SAME Google settings above; no Voximplant API key is needed here.
# VoxEngine endpoint: wss://YOUR-SERVICE.onrender.com/media-stream
# Android event endpoint: wss://YOUR-SERVICE.onrender.com/ws/android
# Android subscribes with user_id + consent; server generates call_id per stream.
# See voximplant/README.md and voximplant/media-stream.js for the wire protocol/scenario.
